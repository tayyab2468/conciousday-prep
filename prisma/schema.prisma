generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Entry {
  id                  Int      @id @default(autoincrement())
  date                DateTime
  journal             String
  intention           String
  dream               String
  priorities          String
  reflection          String
  dream_interpretation String
  mindset_insight     String
  strategy            String
}
